{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "C++: compilar el fichero activo",
      "command": "clang++ -std=c++17 -Wall -Wextra -Wpedantic -Wshadow -g -O0 '${file}' -o '${fileDirname}/${fileBasenameNoExtension}'",
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "type": "shell",
      "label": "C++: compilar todos los .cpp de la carpeta",
      "command": "clang++ -std=c++17 -Wall -Wextra -Wpedantic -Wshadow -g -O0 *.cpp -o programa",
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "type": "shell",
      "label": "C++: compilar el fichero activo CON sanitizers",
      "command": "clang++ -std=c++17 -Wall -Wextra -Wpedantic -Wshadow -g -O0 -fsanitize=address,undefined -fno-omit-frame-pointer '${file}' -o '${fileDirname}/${fileBasenameNoExtension}'",
      "options": { "cwd": "${fileDirname}" },
      "problemMatcher": ["$gcc"],
      "group": "build"
    }
  ]
}
